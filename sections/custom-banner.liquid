<section class="custom-gift-banner">
  <div class="custom-gift-banner__content">
    
    <div class="custom-gift-banner__text">
      <h1>{{ section.settings.heading }}</h1>

      {% if section.settings.description != blank %}
        <p>{{ section.settings.description }}</p>
      {% endif %}

      {% if section.settings.button_label != blank %}
        <a
          href="{{ section.settings.button_link }}"
          class="custom-gift-banner__button"
        >
          {{ section.settings.button_label }}
          <span>→</span>
        </a>
      {% endif %}
    </div>

    {% if section.settings.banner_image != blank %}
      <div class="custom-gift-banner__image">
        {{
          section.settings.banner_image
          | image_url: width: 1800
          | image_tag:
            loading: 'eager',
            widths: '600, 900, 1200, 1500, 1800',
            sizes: '100vw'
        }}
      </div>
    {% endif %}

  </div>
</section>

<style>
  .custom-gift-banner {
    width: 100%;
    overflow: hidden;
    background: #f7f7f5;
  }

  .custom-gift-banner__content {
    position: relative;
    min-height: 560px;
    display: flex;
    align-items: center;
    padding: 70px 7%;
  }

  .custom-gift-banner__text {
    position: relative;
    z-index: 2;
    width: 48%;
  }

  .custom-gift-banner__text h1 {
    margin: 0 0 25px;
    font-size: clamp(42px, 5vw, 76px);
    line-height: 0.98;
    font-weight: 600;
    color: #000;
  }

  .custom-gift-banner__text p {
    max-width: 500px;
    margin: 0 0 30px;
    font-size: 17px;
    line-height: 1.6;
    color: #222;
  }

  .custom-gift-banner__button {
    display: inline-flex;
    align-items: center;
    gap: 30px;
    padding: 15px 24px;
    background: #000;
    color: #fff;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
  }

  .custom-gift-banner__button span {
    font-size: 20px;
    line-height: 1;
  }

  .custom-gift-banner__image {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .custom-gift-banner__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .custom-gift-banner__content {
      min-height: 520px;
      padding: 45px 25px;
      align-items: flex-end;
    }

    .custom-gift-banner__text {
      width: 100%;
    }

    .custom-gift-banner__text h1 {
      font-size: 46px;
    }

    .custom-gift-banner__text p {
      font-size: 15px;
    }
  }
</style>

{% schema %}
{
  "name": "Custom Gift Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Gift Guide"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Discover joy: Your Ultimate Holiday Gift Destination. Explore our curated selection and find the perfect gifts to delight your loved one this holiday season."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "image_picker",
      "id": "banner_image",
      "label": "Banner image"
    }
  ],
  "presets": [
    {
      "name": "Custom Gift Banner"
    }
  ]
}
{% endschema %}