{% comment %}
  Ecomexperts Hiring Test
  Custom Product Grid

  Features:
  - 6 configurable products
  - Product data comes dynamically from Shopify
  - Custom product popup
  - Dynamic variant selectors
  - AJAX Add to Cart
  - Automatically adds Soft Winter Jacket when
    Black + Medium variant is selected
  - Vanilla JavaScript only
{% endcomment %}

<section
  id="custom-product-grid-{{ section.id }}"
  class="custom-product-grid"
  data-section-id="{{ section.id }}"
  data-bundle-product-id="{% if section.settings.bundle_product != blank %}{{ section.settings.bundle_product.selected_or_first_available_variant.id }}{% endif %}"
>

  <div class="custom-grid-container">

    {% if section.settings.heading != blank %}
      <div class="custom-grid-heading">
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="custom-grid">
      {% for block in section.blocks %}
        {% assign product = block.settings.product %}

        {% if product != blank %}
          <article
            class="custom-product-card"
            data-product-card
            data-product-id="{{ product.id }}"
            data-product-handle="{{ product.handle }}"
            {{ block.shopify_attributes }}
          >

            <button
              type="button"
              class="custom-product-card__button"
              data-open-product
              aria-label="View {{ product.title }}"
            >

              <div class="custom-product-card__image">
                {% if product.featured_image %}
                  {{
                    product.featured_image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      widths: '360, 540, 720, 900',
                      sizes: '(min-width: 750px) 33vw, 50vw',
                      alt: product.featured_image.alt
                    | escape
                  }}
                {% else %}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
              </div>

              <div class="custom-product-card__info">

                <h3 class="custom-product-card__title">
                  {{ product.title }}
                </h3>

                <div class="custom-product-card__price">
                  {{ product.price | money }}
                </div>

              </div>

            </button>

            <!-- Product data used by JavaScript -->
            <script type="application/json" data-product-json>
              {
                "id": {{ product.id | json }},
                "title": {{ product.title | json }},
                "description": {{ product.description | strip_html | json }},
                "featured_image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 1000 | json }}{% else %}null{% endif %},
                "price": {{ product.price | money | json }},
                "variants": [
                  {% for variant in product.variants %}
                    {
                      "id": {{ variant.id | json }},
                      "title": {{ variant.title | json }},
                      "available": {{ variant.available | json }},
                      "price": {{ variant.price | money | json }},
                      "options": {{ variant.options | json }}
                    }{% unless forloop.last %},{% endunless %}
                  {% endfor %}
                ],
                "options": [
                  {% for option in product.options_with_values %}
                    {
                      "name": {{ option.name | json }},
                      "values": {{ option.values | json }}
                    }{% unless forloop.last %},{% endunless %}
                  {% endfor %}
                ]
              }
            </script>

          </article>
        {% endif %}
      {% endfor %}
    </div>

  </div>


  <!-- PRODUCT POPUP -->
  <div
    class="custom-product-modal"
    data-product-modal
    aria-hidden="true"
  >

    <div class="custom-product-modal__overlay" data-close-product></div>

    <div
      class="custom-product-modal__content"
      role="dialog"
      aria-modal="true"
      aria-label="Product details"
    >

      <button
        type="button"
        class="custom-product-modal__close"
        data-close-product
        aria-label="Close"
      >
        &times;
      </button>

      <div class="custom-product-modal__grid">

        <div class="custom-product-modal__image-wrapper">
          <img
            data-modal-image
            src=""
            alt=""
            class="custom-product-modal__image"
          >
        </div>

        <div class="custom-product-modal__details">

          <h2 data-modal-title></h2>

          <div
            class="custom-product-modal__price"
            data-modal-price
          ></div>

          <div
            class="custom-product-modal__description"
            data-modal-description
          ></div>

          <form data-product-form>

            <div
              class="custom-product-modal__options"
              data-modal-options
            ></div>

            <button
              type="submit"
              class="custom-product-modal__add"
              data-add-to-cart
            >
              ADD TO CART
            </button>

            <p
              class="custom-product-modal__message"
              data-cart-message
              aria-live="polite"
            ></p>

          </form>

        </div>

      </div>

    </div>
  </div>

</section>


<style>
  #custom-product-grid-{{ section.id }} {
    width: 100%;
    background: #ffffff;
  }

  #custom-product-grid-{{ section.id }} * {
    box-sizing: border-box;
  }

  #custom-product-grid-{{ section.id }} .custom-grid-container {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 60px 40px;
  }

  #custom-product-grid-{{ section.id }} .custom-grid-heading {
    text-align: center;
    margin-bottom: 40px;
  }

  #custom-product-grid-{{ section.id }} .custom-grid-heading h2 {
    margin: 0;
    font-size: 42px;
    line-height: 1.1;
    font-weight: 500;
  }

  #custom-product-grid-{{ section.id }} .custom-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
  }

  #custom-product-grid-{{ section.id }} .custom-product-card {
    min-width: 0;
  }

  #custom-product-grid-{{ section.id }} .custom-product-card__button {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    text-align: left;
    cursor: pointer;
    color: inherit;
  }

  #custom-product-grid-{{ section.id }} .custom-product-card__image {
    position: relative;
    overflow: hidden;
    background: #f5f5f5;
    aspect-ratio: 1 / 1;
  }

  #custom-product-grid-{{ section.id }} .custom-product-card__image img,
  #custom-product-grid-{{ section.id }} .custom-product-card__image svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  #custom-product-grid-{{ section.id }} .custom-product-card__button:hover
  .custom-product-card__image img {
    transform: scale(1.04);
  }

  #custom-product-grid-{{ section.id }} .custom-product-card__info {
    padding-top: 16px;
  }

  #custom-product-grid-{{ section.id }} .custom-product-card__title {
    margin: 0 0 8px;
    font-size: 18px;
    line-height: 1.3;
    font-weight: 500;
  }

  #custom-product-grid-{{ section.id }} .custom-product-card__price {
    font-size: 16px;
    line-height: 1.3;
  }


  /* MODAL */

  #custom-product-grid-{{ section.id }} .custom-product-modal {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
  }

  #custom-product-grid-{{ section.id }} .custom-product-modal.is-open {
    display: block;
  }

  #custom-product-grid-{{ section.id }} .custom-product-modal__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
  }

  #custom-product-grid-{{ section.id }} .custom-product-modal__content {
    position: relative;
    width: min(950px, calc(100% - 40px));
    max-height: calc(100vh - 40px);
    overflow-y: auto;
    margin: 20px auto;
    background: #ffffff;
    padding: 45px;
    top: 50%;
    transform: translateY(-50%);
  }

  #custom-product-grid-{{ section.id }} .custom-product-modal__close {
    position: absolute;
    top: 12px;
    right: 18px;
    width: 40px;
    height: 40px;
    border: 0;
    background: transparent;
    font-size: 34px;
    line-height: 1;
    cursor: pointer;
    z-index: 2;
  }

  #custom-product-grid-{{ section.id }} .custom-product-modal__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 45px;
    align-items: start;
  }

  #custom-product-grid-{{ section.id }} .custom-product-modal__image-wrapper {
    background: #f5f5f5;
  }

  #custom-product-grid-{{ section.id }} .custom-product-modal__image {
    display: block;
    width: 100%;
    height: auto;
  }

  #custom-product-grid-{{ section.id }} .custom-product-modal__details h2 {
    margin: 0 0 15px;
    font-size: 32px;
    line-height: 1.15;
    font-weight: 500;
  }

  #custom-product-grid-{{ section.id }} .custom-product-modal__price {
    margin-bottom: 25px;
    font-size: 20px;
  }

  #custom-product-grid-{{ section.id }} .custom-product-modal__description {
    margin-bottom: 30px;
    font-size: 15px;
    line-height: 1.6;
  }

  #custom-product-grid-{{ section.id }} .custom-product-modal__option {
    margin-bottom: 20px;
  }

  #custom-product-grid-{{ section.id }} .custom-product-modal__option-label {
    display: block;
    margin-bottom: 8px;
    font-size: 14px;
    font-weight: 600;
  }

  #custom-product-grid-{{ section.id }} .custom-product-modal__select {
    width: 100%;
    min-height: 48px;
    padding: 10px 14px;
    border: 1px solid #222222;
    background: #ffffff;
    font-size: 15px;
  }

  #custom-product-grid-{{ section.id }} .custom-product-modal__add {
    width: 100%;
    min-height: 54px;
    margin-top: 10px;
    border: 0;
    background: #111111;
    color: #ffffff;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  #custom-product-grid-{{ section.id }} .custom-product-modal__add:hover {
    transform: translateY(-2px);
  }

  #custom-product-grid-{{ section.id }} .custom-product-modal__add:disabled {
    opacity: 0.5;
    cursor: not-allowed;
    transform: none;
  }

  #custom-product-grid-{{ section.id }} .custom-product-modal__message {
    min-height: 22px;
    margin-top: 12px;
    font-size: 14px;
  }


  /* TABLET */

  @media screen and (max-width: 900px) {
    #custom-product-grid-{{ section.id }} .custom-grid-container {
      padding: 45px 25px;
    }

    #custom-product-grid-{{ section.id }} .custom-grid {
      gap: 20px;
    }

    #custom-product-grid-{{ section.id }} .custom-product-modal__content {
      padding: 35px;
    }

    #custom-product-grid-{{ section.id }} .custom-product-modal__grid {
      gap: 30px;
    }
  }


  /* MOBILE */

  @media screen and (max-width: 749px) {
    #custom-product-grid-{{ section.id }} .custom-grid-container {
      padding: 35px 16px;
    }

    #custom-product-grid-{{ section.id }} .custom-grid-heading {
      margin-bottom: 25px;
    }

    #custom-product-grid-{{ section.id }} .custom-grid-heading h2 {
      font-size: 30px;
    }

    #custom-product-grid-{{ section.id }} .custom-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px 12px;
    }

    #custom-product-grid-{{ section.id }} .custom-product-card__info {
      padding-top: 10px;
    }

    #custom-product-grid-{{ section.id }} .custom-product-card__title {
      font-size: 15px;
    }

    #custom-product-grid-{{ section.id }} .custom-product-card__price {
      font-size: 14px;
    }

    #custom-product-grid-{{ section.id }} .custom-product-modal__content {
      width: calc(100% - 20px);
      max-height: calc(100vh - 20px);
      margin: 10px auto;
      padding: 45px 20px 25px;
    }

    #custom-product-grid-{{ section.id }} .custom-product-modal__grid {
      grid-template-columns: 1fr;
      gap: 25px;
    }

    #custom-product-grid-{{ section.id }} .custom-product-modal__details h2 {
      font-size: 26px;
    }
  }
</style>


<script>
  (() => {
    const section = document.getElementById(
      'custom-product-grid-{{ section.id }}'
    );

    if (!section) return;

    const modal = section.querySelector('[data-product-modal]');
    const modalImage = section.querySelector('[data-modal-image]');
    const modalTitle = section.querySelector('[data-modal-title]');
    const modalPrice = section.querySelector('[data-modal-price]');
    const modalDescription = section.querySelector('[data-modal-description]');
    const modalOptions = section.querySelector('[data-modal-options]');
    const productForm = section.querySelector('[data-product-form]');
    const addButton = section.querySelector('[data-add-to-cart]');
    const cartMessage = section.querySelector('[data-cart-message]');

    let currentProduct = null;


    function openModal(product) {
      currentProduct = product;

      modalImage.src = product.featured_image || '';
      modalImage.alt = product.title;

      modalTitle.textContent = product.title;
      modalPrice.textContent = product.price;
      modalDescription.textContent = product.description || '';

      renderOptions(product);

      cartMessage.textContent = '';

      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');

      document.documentElement.style.overflow = 'hidden';
    }


    function closeModal() {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');

      document.documentElement.style.overflow = '';

      currentProduct = null;
    }


    function renderOptions(product) {
      modalOptions.innerHTML = '';

      if (!product.options || product.options.length === 0) {
        return;
      }

      product.options.forEach((option, optionIndex) => {
        const wrapper = document.createElement('div');
        wrapper.className = 'custom-product-modal__option';

        const label = document.createElement('label');
        label.className = 'custom-product-modal__option-label';
        label.textContent = option.name;

        const select = document.createElement('select');
        select.className = 'custom-product-modal__select';
        select.dataset.optionIndex = optionIndex;

        option.values.forEach((value) => {
          const optionElement = document.createElement('option');

          optionElement.value = value;
          optionElement.textContent = value;

          select.appendChild(optionElement);
        });

        select.addEventListener('change', updateVariantState);

        wrapper.appendChild(label);
        wrapper.appendChild(select);

        modalOptions.appendChild(wrapper);
      });

      updateVariantState();
    }


    function getSelectedOptions() {
      return Array.from(
        modalOptions.querySelectorAll('select')
      ).map((select) => select.value);
    }


    function findSelectedVariant() {
      if (!currentProduct) return null;

      const selectedOptions = getSelectedOptions();

      return currentProduct.variants.find((variant) => {
        return variant.options.every(
          (optionValue, index) =>
            optionValue === selectedOptions[index]
        );
      }) || null;
    }


    function updateVariantState() {
      const variant = findSelectedVariant();

      if (!variant) {
        addButton.disabled = true;
        addButton.textContent = 'UNAVAILABLE';
        return;
      }

      if (!variant.available) {
        addButton.disabled = true;
        addButton.textContent = 'SOLD OUT';
        modalPrice.textContent = variant.price;
        return;
      }

      addButton.disabled = false;
      addButton.textContent = 'ADD TO CART';
      modalPrice.textContent = variant.price;
    }


    function hasBlackAndMediumVariant(variant) {
      if (!variant || !variant.options) {
        return false;
      }

      const values = variant.options.map((value) =>
        String(value).trim().toLowerCase()
      );

      return (
        values.includes('black') &&
        values.includes('medium')
      );
    }


    async function addToCart(variantId) {
      const items = [
        {
          id: variantId,
          quantity: 1
        }
      ];

      /*
        If the selected variant has both Black and Medium,
        automatically add the configured Soft Winter Jacket.
      */

      const bundleProductId =
        section.dataset.bundleProductId;

      const selectedVariant = findSelectedVariant();

      if (
        bundleProductId &&
        hasBlackAndMediumVariant(selectedVariant)
      ) {
        items.push({
          id: Number(bundleProductId),
          quantity: 1
        });
      }

      const response = await fetch(
        `${window.Shopify.routes.root}cart/add.js`,
        {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            items: items
          })
        }
      );

      if (!response.ok) {
        const errorData = await response.json().catch(() => null);

        throw new Error(
          errorData?.description ||
          'Unable to add product to cart.'
        );
      }

      return response.json();
    }


    productForm.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!currentProduct) return;

      const selectedVariant = findSelectedVariant();

      if (!selectedVariant || !selectedVariant.available) {
        return;
      }

      addButton.disabled = true;
      addButton.textContent = 'ADDING...';
      cartMessage.textContent = '';

      try {
        await addToCart(selectedVariant.id);

        cartMessage.textContent =
          'Product added to cart successfully.';

        addButton.textContent = 'ADDED TO CART';

        /*
          Refresh Shopify cart bubble if available.
        */
        if (typeof window.fetchConfig === 'function') {
          fetch(
            `${window.Shopify.routes.root}cart.js`
          ).catch(() => {});
        }

      } catch (error) {
        console.error(error);

        cartMessage.textContent =
          error.message || 'Something went wrong.';

        addButton.disabled = false;
        addButton.textContent = 'ADD TO CART';
      }
    });


    section.querySelectorAll('[data-open-product]').forEach((button) => {
      button.addEventListener('click', () => {
        const card = button.closest('[data-product-card]');
        const productJson = card.querySelector('[data-product-json]');

        if (!productJson) return;

        try {
          const product = JSON.parse(
            productJson.textContent
          );

          openModal(product);
        } catch (error) {
          console.error(
            'Product data could not be loaded.',
            error
          );
        }
      });
    });


    section.querySelectorAll('[data-close-product]').forEach((element) => {
      element.addEventListener('click', closeModal);
    });


    document.addEventListener('keydown', (event) => {
      if (
        event.key === 'Escape' &&
        modal.classList.contains('is-open')
      ) {
        closeModal();
      }
    });

  })();
</script>


{% schema %}
{
  "name": "Custom Product Grid",
  "tag": "section",
  "class": "section-custom-product-grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Products"
    },
    {
      "type": "product",
      "id": "bundle_product",
      "label": "Automatic bundle product",
      "info": "Select Soft Winter Jacket. It will automatically be added when Black and Medium are selected."
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Custom Product Grid",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}